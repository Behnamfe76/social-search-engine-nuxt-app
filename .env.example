# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Social Search Engine API. Server-side only — the browser never sees this host,
# every request goes through the Nitro routes in `server/api`.
#
# Running on the host:   http://localhost:8000/api/v1
# Running under Docker:  http://host.docker.internal:8000/api/v1
NUXT_API_BASE=http://localhost:8000/api/v1

# Host port the container publishes to (docker compose only).
APP_PORT=3000
